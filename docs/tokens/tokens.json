{
  "$description": "Design system of the Portably documentation site: dark by default, with a light palette the theme toggle switches to. The action colour comes from the Portably logo.",
  "color": {
    "palette": {
      "night": { "$type": "color", "$value": "#14141C", "$description": "Page background and cards in the dark theme." },
      "night-code": { "$type": "color", "$value": "#0E0E15", "$description": "Code blocks in the dark theme, a shade deeper than the page." },
      "night-line": { "$type": "color", "$value": "#2A2838", "$description": "Hairlines in the dark theme." },
      "night-strong": { "$type": "color", "$value": "#817D96", "$description": "Field borders, strong lines and file-tree lines in the dark theme." },
      "snow": { "$type": "color", "$value": "#F5F4FA" },
      "mist": { "$type": "color", "$value": "#B8B5C8" },
      "haze": { "$type": "color", "$value": "#9490A8" },
      "lilac": { "$type": "color", "$value": "#C4B5FD", "$description": "Link text and code keywords on dark backgrounds." },
      "sky": { "$type": "color", "$value": "#93B4FF", "$description": "Code: attribute and property names on dark backgrounds." },
      "mint": { "$type": "color", "$value": "#8BDDB0", "$description": "Code: strings on dark backgrounds." },
      "peach": { "$type": "color", "$value": "#F2B880", "$description": "Code: numbers and values on dark backgrounds." },
      "violet": { "$type": "color", "$value": "#7C3AED", "$description": "The action colour, from the logo's purple." },
      "violet-deep": { "$type": "color", "$value": "#6D28D9", "$description": "Hover state, and link text and code keywords on light backgrounds." },
      "cloud": { "$type": "color", "$value": "#F6F5FA", "$description": "Code blocks in the light theme." },
      "fog": { "$type": "color", "$value": "#E4E2EC" },
      "ink": { "$type": "color", "$value": "#161F30", "$description": "The logo's wordmark colour." },
      "graphite": { "$type": "color", "$value": "#4A4E5E" },
      "slate": { "$type": "color", "$value": "#5F6273" },
      "ash": { "$type": "color", "$value": "#6F6D7E", "$description": "File-tree lines on light backgrounds." },
      "cobalt": { "$type": "color", "$value": "#1F4FD1", "$description": "Code: attribute and property names on light backgrounds." },
      "green": { "$type": "color", "$value": "#17794A", "$description": "Code: strings on light backgrounds." },
      "amber": { "$type": "color", "$value": "#A1510E", "$description": "Code: numbers and values on light backgrounds." },
      "white": { "$type": "color", "$value": "#FFFFFF" }
    },
    "background": { "$type": "color", "$value": "{color.palette.night}" },
    "text": {
      "primary": { "$type": "color", "$value": "{color.palette.snow}" },
      "muted": { "$type": "color", "$value": "{color.palette.mist}" },
      "soft": { "$type": "color", "$value": "{color.palette.haze}" },
      "link": { "$type": "color", "$value": "{color.palette.lilac}", "$description": "Links inside running text." }
    },
    "action": {
      "primary": { "$type": "color", "$value": "{color.palette.violet}" },
      "hover": { "$type": "color", "$value": "{color.palette.violet-deep}" },
      "on-primary": { "$type": "color", "$value": "{color.palette.white}" }
    },
    "surface": {
      "raised": { "$type": "color", "$value": "{color.palette.night}", "$description": "Cards: the page colour, set apart by their border." }
    },
    "border": {
      "default": { "$type": "color", "$value": "{color.palette.night-line}" },
      "strong": { "$type": "color", "$value": "{color.palette.night-strong}" }
    },
    "code": {
      "surface": { "$type": "color", "$value": "{color.palette.night-code}", "$description": "Code block background." },
      "text": { "$type": "color", "$value": "{color.palette.snow}", "$description": "Code text, and file and folder names in file trees." },
      "comment": { "$type": "color", "$value": "{color.palette.haze}", "$description": "Comments, and the descriptions in file trees." },
      "keyword": { "$type": "color", "$value": "{color.palette.lilac}", "$description": "Commands, HTML tags and CSS selectors." },
      "name": { "$type": "color", "$value": "{color.palette.sky}", "$description": "Attribute names, CSS properties, JSON keys and command options." },
      "string": { "$type": "color", "$value": "{color.palette.mint}", "$description": "Strings and attribute values." },
      "value": { "$type": "color", "$value": "{color.palette.peach}", "$description": "Numbers, units and literal values." },
      "tree": { "$type": "color", "$value": "{color.palette.night-strong}", "$description": "The lines of a file tree." }
    }
  },
  "space": {
    "0": { "$type": "dimension", "$value": { "value": 0.0, "unit": "rem" } },
    "0-5": { "$type": "dimension", "$value": { "value": 0.125, "unit": "rem" } },
    "1": { "$type": "dimension", "$value": { "value": 0.25, "unit": "rem" } },
    "1-5": { "$type": "dimension", "$value": { "value": 0.375, "unit": "rem" } },
    "2": { "$type": "dimension", "$value": { "value": 0.5, "unit": "rem" } },
    "2-5": { "$type": "dimension", "$value": { "value": 0.625, "unit": "rem" } },
    "3": { "$type": "dimension", "$value": { "value": 0.75, "unit": "rem" } },
    "3-5": { "$type": "dimension", "$value": { "value": 0.875, "unit": "rem" } },
    "4": { "$type": "dimension", "$value": { "value": 1.0, "unit": "rem" } },
    "4-5": { "$type": "dimension", "$value": { "value": 1.125, "unit": "rem" } },
    "5": { "$type": "dimension", "$value": { "value": 1.25, "unit": "rem" } },
    "6": { "$type": "dimension", "$value": { "value": 1.5, "unit": "rem" } },
    "7": { "$type": "dimension", "$value": { "value": 1.75, "unit": "rem" } },
    "8": { "$type": "dimension", "$value": { "value": 2.0, "unit": "rem" } },
    "9": { "$type": "dimension", "$value": { "value": 2.25, "unit": "rem" } },
    "10": { "$type": "dimension", "$value": { "value": 2.5, "unit": "rem" } },
    "12": { "$type": "dimension", "$value": { "value": 3.0, "unit": "rem" } },
    "16": { "$type": "dimension", "$value": { "value": 4.0, "unit": "rem" } }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
    "full": { "$type": "dimension", "$value": { "value": 999, "unit": "px" } },
    "none": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
    "md": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
    "lg": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } }
  },
  "font": {
    "family": {
      "body": { "$type": "fontFamily", "$value": [ "Inter", "system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif" ], "$description": "Inter, stored in assets/fonts with its licence." },
      "mono": { "$type": "fontFamily", "$value": [ "ui-monospace", "SFMono-Regular", "Menlo", "Consolas", "monospace" ], "$description": "Code and commands." }
    },
    "size": {
      "base": { "$type": "dimension", "$value": { "value": 1, "unit": "rem" } },
      "lg": { "$type": "dimension", "$value": { "value": 1.25, "unit": "rem" } },
      "xs": { "$type": "dimension", "$value": { "value": 0.75, "unit": "rem" } },
      "sm": { "$type": "dimension", "$value": { "value": 0.875, "unit": "rem" } },
      "md": { "$type": "dimension", "$value": { "value": 1.125, "unit": "rem" } },
      "xl": { "$type": "dimension", "$value": { "value": 1.5, "unit": "rem" } },
      "2xl": { "$type": "dimension", "$value": { "value": 2, "unit": "rem" } },
      "3xl": { "$type": "dimension", "$value": { "value": 2.5, "unit": "rem" } },
      "4xl": { "$type": "dimension", "$value": { "value": 3, "unit": "rem" } },
      "5xl": { "$type": "dimension", "$value": { "value": 4, "unit": "rem" } }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold": { "$type": "fontWeight", "$value": 700 },
      "light": { "$type": "fontWeight", "$value": 300 }
    },
    "line-height": {
      "tight": { "$type": "number", "$value": 1.15 },
      "snug": { "$type": "number", "$value": 1.25 },
      "body": { "$type": "number", "$value": 1.5 },
      "relaxed": { "$type": "number", "$value": 1.6 }
    },
    "tracking": {
      "body": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
      "label": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
      "tight": { "$type": "dimension", "$value": { "value": -0.04, "unit": "em" }, "$description": "Tighter letter spacing for large display headings." },
      "heading": { "$type": "dimension", "$value": { "value": -0.02, "unit": "em" }, "$description": "Page and section headings." }
    }
  },
  "text": {
    "heading": {
      "lg": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.body}",
          "fontSize": "{font.size.3xl}",
          "fontWeight": "{font.weight.bold}",
          "letterSpacing": "{font.tracking.heading}",
          "lineHeight": "{font.line-height.tight}"
        }
      },
      "md": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.body}",
          "fontSize": "{font.size.xl}",
          "fontWeight": "{font.weight.semibold}",
          "letterSpacing": "{font.tracking.heading}",
          "lineHeight": "{font.line-height.snug}"
        }
      }
    },
    "body": {
      "md": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.body}",
          "fontSize": "{font.size.base}",
          "fontWeight": "{font.weight.regular}",
          "letterSpacing": "{font.tracking.body}",
          "lineHeight": "{font.line-height.body}"
        }
      },
      "lg": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.body}",
          "fontSize": "{font.size.md}",
          "fontWeight": "{font.weight.regular}",
          "letterSpacing": "{font.tracking.body}",
          "lineHeight": "{font.line-height.relaxed}"
        }
      }
    },
    "label": {
      "sm": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.body}",
          "fontSize": "{font.size.xs}",
          "fontWeight": "{font.weight.semibold}",
          "letterSpacing": "{font.tracking.label}",
          "lineHeight": "{font.line-height.snug}"
        }
      }
    }
  },
  "shadow": {
    "sm": {
      "$type": "shadow",
      "$value": {
        "color": "rgb(0 0 0 / 0.08)",
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 1,
          "unit": "px"
        },
        "blur": {
          "value": 3,
          "unit": "px"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      }
    },
    "md": {
      "$type": "shadow",
      "$value": {
        "color": "rgb(0 0 0 / 0.32)",
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 4,
          "unit": "px"
        },
        "blur": {
          "value": 12,
          "unit": "px"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      }
    },
    "lg": {
      "$type": "shadow",
      "$value": {
        "color": "rgb(0 0 0 / 0.4)",
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 12,
          "unit": "px"
        },
        "blur": {
          "value": 32,
          "unit": "px"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      }
    }
  },
  "button": {
    "$description": "The shape of the Portably button (pbly-btn). Point these at other tokens to match the design; colours come from the action roles.",
    "radius": { "$type": "dimension", "$value": "{radius.md}" },
    "padding-block": { "$type": "dimension", "$value": "{space.2}" },
    "padding-inline": { "$type": "dimension", "$value": "{space.4}" },
    "min-height": { "$type": "dimension", "$value": "{space.10}" },
    "font-weight": { "$type": "fontWeight", "$value": "{font.weight.semibold}" }
  },
  "layout": {
    "wrapper": {
      "max": { "$type": "dimension", "$value": { "value": 90, "unit": "rem" }, "$description": "The widest the documentation gets, not counting the side margins: sidebar, article and the list of sections." },
      "narrow": { "$type": "dimension", "$value": { "value": 47.5, "unit": "rem" } },
      "gutter": { "$type": "dimension", "$value": "{space.6}", "$description": "The side margin that keeps content off the screen edge." }
    },
    "section": {
      "padding": { "$type": "dimension", "$value": "{space.12}", "$description": "Space inside each section, above and below its content. Two sections next to each other are twice this far apart." }
    },
    "sidebar": {
      "width": { "$type": "dimension", "$value": { "value": 15, "unit": "rem" } }
    },
    "measure": {
      "normal": { "$type": "dimension", "$value": { "value": 40, "unit": "rem" } },
      "wide": { "$type": "dimension", "$value": { "value": 48, "unit": "rem" }, "$description": "The widest an article gets." }
    },
    "toc": {
      "width": { "$type": "dimension", "$value": { "value": 13, "unit": "rem" }, "$description": "The \"On this page\" list beside the article." }
    },
    "header": {
      "height": { "$type": "dimension", "$value": "{space.16}", "$description": "The height of the site header, which the sidebar and headings stay clear of." }
    }
  }
}

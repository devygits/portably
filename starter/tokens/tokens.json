{
  "$description": "Default design system for a Portably project. Replace values with the source design's decisions; keep every required role, and keep baseline spacing steps at their values. See standard/SYSTEM.md.",
  "color": {
    "palette": {
      "canvas": {"$type":"color","$value":"#F8FAFC"},
      "ink": {"$type":"color","$value":"#172033"},
      "graphite": {"$type":"color","$value":"#475569"},
      "slate": {"$type":"color","$value":"#64748B"},
      "line": {"$type":"color","$value":"#CBD5E1"},
      "accent": {"$type":"color","$value":"#2563EB"},
      "accent-hover": {"$type":"color","$value":"#1D4ED8"},
      "white": {"$type":"color","$value":"#FFFFFF"}
    },
    "background":{"$type":"color","$value":"{color.palette.canvas}"},
    "text":{
      "primary":{"$type":"color","$value":"{color.palette.ink}"},
      "muted":{"$type":"color","$value":"{color.palette.graphite}"},
      "soft":{"$type":"color","$value":"{color.palette.slate}"}
    },
    "action":{
      "primary":{"$type":"color","$value":"{color.palette.accent}"},
      "hover":{"$type":"color","$value":"{color.palette.accent-hover}"},
      "on-primary":{"$type":"color","$value":"{color.palette.white}"}
    },
    "surface":{"raised":{"$type":"color","$value":"{color.palette.white}"}},
    "border":{
      "default":{"$type":"color","$value":"{color.palette.line}"},
      "strong":{"$type":"color","$value":"{color.palette.ink}"}
    }
  },
  "space":{
    "0":{"$type":"dimension","$value":{"value":0.0,"unit":"rem"}},
    "0-5":{"$type":"dimension","$value":{"value":0.125,"unit":"rem"}},
    "1":{"$type":"dimension","$value":{"value":0.25,"unit":"rem"}},
    "1-5":{"$type":"dimension","$value":{"value":0.375,"unit":"rem"}},
    "2":{"$type":"dimension","$value":{"value":0.5,"unit":"rem"}},
    "2-5":{"$type":"dimension","$value":{"value":0.625,"unit":"rem"}},
    "3":{"$type":"dimension","$value":{"value":0.75,"unit":"rem"}},
    "3-5":{"$type":"dimension","$value":{"value":0.875,"unit":"rem"}},
    "4":{"$type":"dimension","$value":{"value":1.0,"unit":"rem"}},
    "4-5":{"$type":"dimension","$value":{"value":1.125,"unit":"rem"}},
    "5":{"$type":"dimension","$value":{"value":1.25,"unit":"rem"}},
    "6":{"$type":"dimension","$value":{"value":1.5,"unit":"rem"}},
    "7":{"$type":"dimension","$value":{"value":1.75,"unit":"rem"}},
    "8":{"$type":"dimension","$value":{"value":2.0,"unit":"rem"}},
    "9":{"$type":"dimension","$value":{"value":2.25,"unit":"rem"}},
    "10":{"$type":"dimension","$value":{"value":2.5,"unit":"rem"}},
    "12":{"$type":"dimension","$value":{"value":3.0,"unit":"rem"}},
    "16":{"$type":"dimension","$value":{"value":4.0,"unit":"rem"}}
  },
  "radius":{
    "sm":{"$type":"dimension","$value":{"value":4,"unit":"px"}},
    "full":{"$type":"dimension","$value":{"value":999,"unit":"px"}},
    "none":{"$type":"dimension","$value":{"value":0,"unit":"px"}},
    "md":{"$type":"dimension","$value":{"value":8,"unit":"px"}},
    "lg":{"$type":"dimension","$value":{"value":16,"unit":"px"}}
  },
  "font":{
    "family":{"body":{"$type":"fontFamily","$value":["system-ui","sans-serif"]}},
    "size":{
      "base":{"$type":"dimension","$value":{"value":1,"unit":"rem"}},
      "lg":{"$type":"dimension","$value":{"value":1.25,"unit":"rem"}},
      "xs":{"$type":"dimension","$value":{"value":0.75,"unit":"rem"}},
      "sm":{"$type":"dimension","$value":{"value":0.875,"unit":"rem"}},
      "md":{"$type":"dimension","$value":{"value":1.125,"unit":"rem"}},
      "xl":{"$type":"dimension","$value":{"value":1.5,"unit":"rem"}},
      "2xl":{"$type":"dimension","$value":{"value":2,"unit":"rem"}},
      "3xl":{"$type":"dimension","$value":{"value":2.5,"unit":"rem"}},
      "4xl":{"$type":"dimension","$value":{"value":3,"unit":"rem"}},
      "5xl":{"$type":"dimension","$value":{"value":4,"unit":"rem"}}
    },
    "weight":{
      "regular":{"$type":"fontWeight","$value":400},
      "medium":{"$type":"fontWeight","$value":500},
      "semibold":{"$type":"fontWeight","$value":600},
      "bold":{"$type":"fontWeight","$value":700},
      "light":{"$type":"fontWeight","$value":300}
    },
    "line-height":{
      "tight":{"$type":"number","$value":1.15},
      "snug":{"$type":"number","$value":1.25},
      "body":{"$type":"number","$value":1.5},
      "relaxed":{"$type":"number","$value":1.6}
    },
    "tracking":{
      "body":{"$type":"dimension","$value":{"value":0,"unit":"px"}},
      "label":{"$type":"dimension","$value":{"value":0,"unit":"px"}},
      "tight":{"$type":"dimension","$value":{"value":-0.04,"unit":"em"},"$description":"Tighter letter spacing for large display headings."}
    }
  },
  "text":{
    "heading":{
      "lg":{"$type":"typography","$value":{"fontFamily":"{font.family.body}","fontSize":"{font.size.4xl}","fontWeight":"{font.weight.medium}","letterSpacing":"{font.tracking.body}","lineHeight":"{font.line-height.tight}"}},
      "md":{"$type":"typography","$value":{"fontFamily":"{font.family.body}","fontSize":"{font.size.3xl}","fontWeight":"{font.weight.medium}","letterSpacing":"{font.tracking.body}","lineHeight":"{font.line-height.tight}"}}
    },
    "body":{
      "md":{"$type":"typography","$value":{"fontFamily":"{font.family.body}","fontSize":"{font.size.base}","fontWeight":"{font.weight.regular}","letterSpacing":"{font.tracking.body}","lineHeight":"{font.line-height.body}"}},
      "lg":{"$type":"typography","$value":{"fontFamily":"{font.family.body}","fontSize":"{font.size.md}","fontWeight":"{font.weight.regular}","letterSpacing":"{font.tracking.body}","lineHeight":"{font.line-height.relaxed}"}}
    },
    "label":{"sm":{"$type":"typography","$value":{"fontFamily":"{font.family.body}","fontSize":"{font.size.xs}","fontWeight":"{font.weight.medium}","letterSpacing":"{font.tracking.label}","lineHeight":"{font.line-height.snug}"}}}
  },
  "shadow":{
    "sm":{"$type":"shadow","$value":{"color":"rgb(0 0 0 / 0.08)","offsetX":{"value":0,"unit":"px"},"offsetY":{"value":1,"unit":"px"},"blur":{"value":3,"unit":"px"},"spread":{"value":0,"unit":"px"}}},
    "md":{"$type":"shadow","$value":{"color":"rgb(0 0 0 / 0.12)","offsetX":{"value":0,"unit":"px"},"offsetY":{"value":4,"unit":"px"},"blur":{"value":12,"unit":"px"},"spread":{"value":0,"unit":"px"}}},
    "lg":{"$type":"shadow","$value":{"color":"rgb(0 0 0 / 0.18)","offsetX":{"value":0,"unit":"px"},"offsetY":{"value":12,"unit":"px"},"blur":{"value":32,"unit":"px"},"spread":{"value":0,"unit":"px"}}}
  },
  "button":{
    "$description":"The shape of the Portably button (pbly-btn). Point these at other tokens to match the design; colours come from the action roles.",
    "radius":{"$type":"dimension","$value":"{radius.sm}"},
    "padding-block":{"$type":"dimension","$value":"{space.2}"},
    "padding-inline":{"$type":"dimension","$value":"{space.4}"},
    "min-height":{"$type":"dimension","$value":"{space.12}"},
    "font-weight":{"$type":"fontWeight","$value":"{font.weight.medium}"}
  },
  "layout":{
    "wrapper":{
      "max":{"$type":"dimension","$value":{"value":75,"unit":"rem"},"$description":"The widest the content gets, not counting the side margins. A design with a 1440px frame and 80px margins on each side is 1280px."},
      "narrow":{"$type":"dimension","$value":{"value":47.5,"unit":"rem"}},
      "gutter":{"$type":"dimension","$value":"{space.6}","$description":"The side margin that keeps content off the screen edge."}
    },
    "section":{
      "padding":{"$type":"dimension","$value":"{space.16}","$description":"Space inside each section, above and below its content. Two sections next to each other are twice this far apart."}
    },
    "sidebar":{
      "width":{"$type":"dimension","$value":{"value":16,"unit":"rem"}}
    },
    "measure":{
      "normal":{"$type":"dimension","$value":{"value":40,"unit":"rem"}},
      "wide":{"$type":"dimension","$value":{"value":62,"unit":"rem"}}
    }
  }
}
